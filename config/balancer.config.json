{
  "hard_stop_percent": 90,
  "reserve_percent": {
    "claude": 10,
    "opencode": 0
  },
  "hysteresis_points": 10,
  "use_it_or_lose_it_minutes": 30,
  "use_it_or_lose_it_bonus": 15,
  "stale_minutes": 15,
  "usage_cache_seconds": 60,
  "fetch_timeout_ms": 4000,
  "wait_max_sleep_seconds": 300,
  "windows_minutes": {
    "rolling": 300,
    "weekly": 10080,
    "monthly": 43200,
    "five_hour": 300,
    "seven_day": 10080
  },
  "lanes": {
    "opencode_agent_prefix": "go-",
    "pinned_to_claude": [],
    "balanced_agents": "*",
    "default_lane": "opencode",
    "preferences": {},
    "escalate_on": [
      "limit",
      "model_gone"
    ]
  },
  "inflight": {
    "ttl_minutes": 30,
    "cost_points": 2
  },
  "strategy": {
    "runs_remaining": true,
    "min_samples": 5,
    "hysteresis_runs": 2,
    "burn_decay": 0.9
  },
  "reactive": {
    "backoff_initial_seconds": 30,
    "backoff_max_seconds": 900,
    "hint_max_seconds": 86400,
    "probe_timeout_minutes": 15,
    "breaker_failures": 3,
    "breaker_open_seconds": 30,
    "limit_patterns": [
      "\\b429\\b",
      "GoUsageLimitError",
      "usage limit",
      "rate[ _-]?limit",
      "limit reached"
    ],
    "model_gone_cooldown_seconds": 3600,
    "model_gone_patterns": [
      "model[ _-]?not[ _-]?found",
      "model_not_found",
      "\\b(HTTP|status(Code)?)\\W{0,3}404\\b",
      "model\\b[^\\n]{0,120}does not exist",
      "model\\b[^\\n]{0,120}retired"
    ]
  },
  "free_lane": {
    "enabled": false,
    "models": [
      "opencode/deepseek-v4.1-flash-free",
      "opencode/glm-5.3-flash-free",
      "opencode/mimo-v2.6-flash-free",
      "opencode/minimax-m3.1-flash-free",
      "opencode/longcat-2.5-free",
      "opencode/hy4-flash-free",
      "opencode/big-pickle"
    ],
    "agents": [],
    "canary_ttl_days": 7,
    "canary_timeout_seconds": 300,
    "escalate_on_failure": true,
    "renew_canary_on_success": true,
    "require_toolcall": true,
    "rotate": false,
    "spend_guard": {}
  },
  "catalog": {
    "ttl_seconds": 600,
    "timeout_seconds": 20,
    "check_agent_models": true
  },
  "claude": {
    "model": "sonnet",
    "effort": "medium",
    "permission_mode": "acceptEdits",
    "allowed_tools": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "disallowed_tools": [
      "Bash(git push:*)"
    ],
    "agent_prompt_dir": null
  },
  "opencode": {
    "agent_models": {}
  },
  "paygo": {
    "enabled": false,
    "model": null,
    "max_runs_per_day": 10
  },
  "relay": {
    "max_run_minutes": 180,
    "scrub_env_free": true,
    "env_scrub_patterns": [
      "KEY",
      "TOKEN",
      "SECRET",
      "PASSWORD",
      "PASSWD",
      "CREDENTIAL"
    ],
    "env_keep": []
  },
  "log": {
    "enabled": true,
    "max_bytes": 5242880
  }
}
