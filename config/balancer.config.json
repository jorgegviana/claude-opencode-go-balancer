{
  "hard_stop_percent": 90,
  "hysteresis_points": 10,
  "use_it_or_lose_it_minutes": 30,
  "use_it_or_lose_it_bonus": 15,
  "stale_minutes": 15,
  "usage_cache_seconds": 60,
  "fetch_timeout_ms": 4000,
  "wait_max_sleep_seconds": 300,
  "windows_minutes": {
    "rolling": 300,
    "weekly": 10080,
    "monthly": 43200,
    "five_hour": 300,
    "seven_day": 10080
  },
  "lanes": {
    "opencode_agent_prefix": "go-",
    "pinned_to_claude": [],
    "balanced_agents": "*",
    "default_lane": "opencode"
  },
  "reactive": {
    "backoff_initial_seconds": 30,
    "backoff_max_seconds": 900,
    "hint_max_seconds": 86400,
    "probe_timeout_minutes": 15,
    "breaker_failures": 3,
    "breaker_open_seconds": 30,
    "limit_patterns": [
      "\\b429\\b",
      "GoUsageLimitError",
      "usage limit",
      "rate[ _-]?limit",
      "limit reached"
    ]
  },
  "claude": {
    "model": "sonnet",
    "effort": "medium",
    "permission_mode": "acceptEdits",
    "allowed_tools": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node --test:*)",
      "Bash(npm test:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "agent_prompt_dir": null,
    "disallowed_tools": [
      "Bash(git push:*)"
    ]
  },
  "opencode": {
    "agent_models": {}
  },
  "paygo": {
    "enabled": false,
    "model": null
  }
}
