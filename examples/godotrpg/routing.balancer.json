      "gsd-phase-researcher": "opencode-go/deepseek-v4-pro",
      "gsd-code-reviewer": "opencode-go/glm-5.3",
      "gsd-verifier": "opencode-go/glm-5.3",
      "gsd-eval-auditor": "opencode-go/glm-5.3",
