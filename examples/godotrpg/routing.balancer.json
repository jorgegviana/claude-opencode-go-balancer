{
  "_comment": "Balancer config for the godotrpg GSD setup. Use with BALANCER_CONFIG=<this file>. GSD agent names live only in examples.",
  "lanes": {
    "opencode_agent_prefix": "go-",
    "pinned_to_claude": [
