#!/usr/bin/env node
'use strict';
// Generic relay of an agent task to a headless provider chosen by the balancer.
//   balancer-relay start <agent> <prompt-file>   start in the background (opencode, claude, or deferred)
//   balancer-relay wait  <prompt-file>           wait up to BALANCER_RELAY_WAIT_SECONDS (570); RUNNING or DONE + report
//   balancer-relay cancel <prompt-file>          stop a running or deferred run without counting a failure
//   balancer-relay verdict <prompt-file> accept|reject   record whether the result was used (for stats)
// Run from the directory the work belongs to (it may be a git worktree).
const fs = require('fs');
const path = require('path');
const cp = require('child_process');
const engine = require('../lib/engine.cjs');
const { extractReport } = require('../lib/report.cjs');
const { logicalAgent } = require('../lib/decide.cjs');
const { expandHome } = require('../lib/state.cjs');

const USAGE = 'usage: balancer-relay start <agent> <prompt-file> | wait <prompt-file> | cancel <prompt-file> | verdict <prompt-file> accept|reject';
const RETRY = ' NOTE: an earlier attempt at this task on another provider ended without a report. The working tree may already contain its partial changes: run git status and git diff first, keep what is correct, fix or finish the rest, and say in your report what you found.';
const RULES = 'STANDING RULES from the relay (they override anything softer in the attached file): (a) Never read or write outside the project root. TMPDIR is already set to the project\'s build/tmp: use it for scratch files. Never write to /tmp. Never make backup copies of files anywhere; git is the rollback (use git diff, and git checkout only on files you yourself changed). Do not use git stash. (b) Your final report must be complete even if a step failed: list commits you made, files you left uncommitted, and the raw output lines of every verification command you ran (copy them, do not paraphrase, do not quote numbers from earlier reports). (c) If a command is rejected or blocked, do not stop: report what was blocked and continue with what remains possible.';

const git = (args, cwd) => {
  const r = cp.spawnSync('git', args, { cwd, encoding: 'utf8' });
  return r.status === 0 ? r.stdout : null;
};

function binFor(provider) {
  const env = process.env;
  return provider === 'claude' ? env.BALANCER_CLAUDE_BIN || 'claude' : env.BALANCER_OPENCODE_BIN || 'opencode';
}

function onPath(bin) {
  if (bin.includes('/')) {
    try { fs.accessSync(bin, fs.constants.X_OK); return true; } catch { return false; }
  }
  return (process.env.PATH || '').split(path.delimiter).some((d) => {
    try { fs.accessSync(path.join(d, bin), fs.constants.X_OK); return true; } catch { return false; }
  });
}

function repoRoot(cwd) {
  const r = git(['rev-parse', '--show-toplevel'], cwd);
  return r ? r.trim() : cwd;
}

// Free models are the least trusted lane: they do not get secret-looking environment variables.
function scrubbed(src, cfg) {
  const r = (cfg && cfg.relay) || {};
  if (!r.scrub_env_free) return { ...src };
  const pats = (r.env_scrub_patterns || []).map((x) => new RegExp(x, 'i'));
  const keep = new Set(r.env_keep || []);
  const out = {};
  for (const [k, v] of Object.entries(src)) if (keep.has(k) || !pats.some((re) => re.test(k))) out[k] = v;
  return out;
}

function childEnv(cwd, provider, cfg) {
  const root = repoRoot(cwd);
  const env = {
    ...(provider === 'free' ? scrubbed(process.env, cfg) : process.env),
    TMPDIR: path.join(root, 'build', 'tmp'),
    XDG_CACHE_HOME: path.join(root, 'build', 'cache'),
    UV_CACHE_DIR: path.join(root, 'build', 'uv-cache'),
  };
  for (const d of [env.TMPDIR, env.XDG_CACHE_HOME, env.UV_CACHE_DIR]) {
    try { fs.mkdirSync(d, { recursive: true }); } catch { /* best effort */ }
  }
  if (provider !== 'claude') env.OPENCODE_ENABLE_EXA = '1';
  return env;
}

function agentBody(cfg, agent) {
  const dir = cfg.claude.agent_prompt_dir && expandHome(cfg.claude.agent_prompt_dir);
  if (!dir) return null;
  try {
    const t = fs.readFileSync(path.join(dir, logicalAgent(agent, cfg) + '.md'), 'utf8');
    return t.replace(/^---\n[\s\S]*?\n---\n?/, '').trim() || null;
  } catch {
    return null;
  }
}

function providerArgs(provider, { agent, cwd, prompt, cfg, paygo, model, retry }) {
  if (provider === 'claude') {
    const c = cfg.claude;
    const abs = path.resolve(cwd, prompt);
    const msg = `Read the file ${abs} and execute the task in it exactly as written. It is your full spawn prompt from the orchestrator. Finish with the structured report it asks for. ${RULES}${retry ? RETRY : ''}`;
    const args = ['-p', msg, '--output-format', 'stream-json', '--verbose', '--model', c.model, '--effort', c.effort,
      '--permission-mode', c.permission_mode];
    const body = agentBody(cfg, agent);
    if (body) args.push('--append-system-prompt', body);
    args.push('--allowedTools', ...c.allowed_tools);
    if (Array.isArray(c.disallowed_tools) && c.disallowed_tools.length) args.push('--disallowedTools', ...c.disallowed_tools);
    args.push('--add-dir', cwd);
    return args;
  }
  const msg = `Execute the task in the attached file exactly as written. It is your full spawn prompt from the orchestrator. Finish with the structured report it asks for. ${RULES}${retry ? RETRY : ''}`;
  const args = ['run', msg, '--agent', agent, '--dir', cwd, '--format', 'json', '-f', prompt];
  if (provider === 'free') args.push('--model', model);
  else if (paygo && cfg.paygo.model) args.push('--model', cfg.paygo.model);
  return args;
}

function spawnProvider(provider, opts) {
  const { cwd, prompt } = opts;
  const out = fs.openSync(prompt + '.jsonl', 'w');
  const err = fs.openSync(prompt + '.err', 'w');
  // relay.wrap_command prefixes the provider command (a sandbox, a container runner, ...).
  const wrap = ((opts.cfg.relay && opts.cfg.relay.wrap_command) || []).map((a) => a.split('{root}').join(repoRoot(cwd)));
  const argv = [...wrap, binFor(provider), ...providerArgs(provider, { ...opts, retry: fs.existsSync(prompt + '.escalated') })];
  const child = cp.spawn(argv[0], argv.slice(1), {
    cwd, detached: true, stdio: ['ignore', out, err], env: childEnv(cwd, provider, opts.cfg),
  });
  fs.closeSync(out);
  fs.closeSync(err);
  // A paygo run is opencode on separate billing: it is recorded as 'paygo', never as the Go subscription.
  fs.writeFileSync(prompt + '.provider', (opts.paygo ? 'paygo' : provider) + '\n');
  fs.writeFileSync(prompt + '.launched', Date.now() + '\n');
  fs.rmSync(prompt + '.recorded', { force: true });
  try { engine.attachRun(engine.makeCtx(), { provider, agent: opts.agent, pid: child.pid }); } catch { /* bookkeeping only */ }
  if (provider === 'free') fs.writeFileSync(prompt + '.model', opts.model + '\n');
  else fs.rmSync(prompt + '.model', { force: true });
  return child;
}

// Map a pick verdict to the provider that actually runs ('free' | 'claude' | 'opencode').
const providerOf = (verdict) => (verdict === 'free' ? 'free' : verdict === 'claude' ? 'claude' : 'opencode');

// Spawn the chosen provider for a non-wait verdict; returns the child.
function launch(d, { agent, cwd, prompt, cfg }) {
  return spawnProvider(providerOf(d.verdict), { agent, cwd, prompt, cfg, paygo: d.verdict === 'paygo', model: d.model });
}

async function safePick(ctx, agent, opts) {
  try {
    return await engine.pick(ctx, agent, opts);
  } catch (e) {
    // Pinning is a privacy setting: it holds even when the balancer itself is broken.
    const pinned = ctx.cfg.lanes.pinned_to_claude.includes(logicalAgent(agent, ctx.cfg));
    const verdict = pinned ? 'claude' : 'opencode';
    process.stderr.write(`relay: balancer failed (${String(e && e.message).slice(0, 120)}); using ${verdict}\n`);
    return { verdict, reason: 'balancer error fallback' };
  }
}

// Detached worker that waits for a provider to recover (see deferred()).
function spawnDeferred(agent, cwd, prompt) {
  const out = fs.openSync(prompt + '.err', 'w');
  for (const ext of ['launched', 'child', 'recorded']) fs.rmSync(`${prompt}.${ext}`, { force: true });
  const w = cp.spawn(process.execPath, [__filename, '_deferred', agent, prompt], {
    cwd, detached: true, stdio: ['ignore', out, out], env: childEnv(cwd, 'claude'),
  });
  fs.closeSync(out);
  w.unref();
  fs.writeFileSync(prompt + '.pid', w.pid + '\n');
  fs.writeFileSync(prompt + '.provider', 'deferred\n');
  return w;
}

async function start(agent, prompt) {
  if (!agent || !prompt) { console.log(USAGE); return 2; }
  let ok = false;
  try { ok = fs.statSync(prompt).size > 0; } catch { ok = false; }
  if (!ok) { console.log(`relay-failure: prompt file missing or empty: ${prompt}`); return 2; }
  const cwd = process.cwd();
  const ctx = engine.makeCtx();
  const d = await safePick(ctx, agent);
  const verdict = d.verdict === 'wait' || d.verdict === 'paygo' || d.verdict === 'free' ? d.verdict : d.verdict === 'claude' ? 'claude' : 'opencode';
  if (verdict !== 'wait') {
    const bin = binFor(providerOf(verdict));
    if (!onPath(bin)) {
      // Nothing will run: give back the probe and in-flight slot the pick claimed.
      try { engine.releaseRun(ctx, { provider: providerOf(verdict), agent, model: d.model }); } catch { /* best effort */ }
      console.log(`relay-failure: ${bin} not on PATH`);
      return 2;
    }
  }
  for (const ext of ['recorded', 'timeout', 'escalated', 'child', 'launched']) fs.rmSync(`${prompt}.${ext}`, { force: true });
  const gitDir = git(['rev-parse', '--git-common-dir'], cwd);
  if (gitDir) {
    const ex = path.resolve(cwd, gitDir.trim(), 'info', 'exclude');
    try {
      if (fs.existsSync(ex)) {
        const have = fs.readFileSync(ex, 'utf8').split('\n');
        // The relay's own files must not show up as changes made by the agent.
        const rel = path.relative(repoRoot(cwd), path.resolve(cwd, prompt)).split(path.sep).join('/');
        const want = ['.opencode-relay/'];
        if (!rel.startsWith('..') && !rel.startsWith('.opencode-relay/')) want.push(`/${rel}.*`);
        const add = want.filter((l) => !have.includes(l));
        if (add.length) fs.appendFileSync(ex, add.join('\n') + '\n');
      }
    } catch { /* best effort */ }
  }
  const head = git(['rev-parse', 'HEAD'], cwd);
  fs.writeFileSync(prompt + '.base', head ? head.trim() + '\n' : '');
  fs.writeFileSync(prompt + '.agent', agent + '\n');

  if (verdict === 'wait') {
    const w = spawnDeferred(agent, cwd, prompt);
    console.log(`started pid ${w.pid} agent=${agent} provider=deferred`);
    console.log(`relay: both subscriptions limited, deferred until ${d.until ? new Date(d.until).toISOString() : 'unknown'}`);
    return 0;
  }
  const provider = providerOf(verdict);
  const child = launch({ verdict, model: d.model }, { agent, cwd, prompt, cfg: ctx.cfg });
  child.unref();
  fs.writeFileSync(prompt + '.pid', child.pid + '\n');
  console.log(`started pid ${child.pid} agent=${agent} provider=${provider}${provider === 'free' ? ` model=${d.model}` : ''}${verdict === 'paygo' ? ' (paygo)' : ''}`);
  return 0;
}

// Detached worker: wait for any provider to recover, re-pick, run the chosen one to completion.
async function deferred(agent, prompt) {
  const cwd = process.cwd();
  const ctx = engine.makeCtx();
  const esc = /^(\S+) /.exec(readText(prompt + '.escalated'));
  const opts = { excludeFree: fs.existsSync(prompt + '.escalated'), excludeProvider: esc && esc[1] !== 'free' ? esc[1] : undefined };
  let d;
  for (;;) {
    try { await engine.waitReset(ctx, { maxSeconds: Infinity, agent }); } catch { await ctx.sleep(30000); }
    d = await safePick(ctx, agent, opts);
    if (d.verdict !== 'wait') break;
    // pick can still say wait for reasons waitReset does not see (catalog, paygo cap, exclusion):
    // sleep until its estimate instead of spinning.
    const ms = Number.isFinite(d.until) ? d.until - ctx.now() : Infinity;
    await ctx.sleep(Math.max(1000, Math.min(ms, ctx.cfg.wait_max_sleep_seconds * 1000)));
  }
  const child = launch(d, { agent, cwd, prompt, cfg: ctx.cfg });
  fs.writeFileSync(prompt + '.child', child.pid + '\n');
  // Cancelling or timing out the worker must also stop the provider it started.
  process.on('SIGTERM', () => { try { process.kill(-child.pid, 'SIGTERM'); } catch { /* gone */ } process.exit(143); });
  await new Promise((resolve) => { child.on('exit', resolve); child.on('error', resolve); });
  return 0;
}

const alive = (pid) => {
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; }
};
const readText = (f, dflt = '') => { try { return fs.readFileSync(f, 'utf8'); } catch { return dflt; } };

function repoDelta(base, cwd) {
  const out = [];
  const valid = base && git(['rev-parse', '--verify', '--quiet', `${base}^{commit}`], cwd) !== null;
  if (valid) {
    out.push(`commits since launch (${base}..HEAD):`);
    const log = (git(['log', '--oneline', '--no-decorate', `${base}..HEAD`], cwd) || '').split('\n').filter(Boolean);
    for (const l of log) out.push('  ' + l);
    if (!log.length) out.push('  (none)');
  } else {
    out.push('commits since launch: unknown (no recorded base)');
  }
  out.push('uncommitted/untracked (git status --short):');
  const st = (git(['status', '--short'], cwd) || '').split('\n').filter(Boolean);
  for (const l of st) out.push('  ' + l);
  if (!st.length) out.push('  (clean)');
  return out.join('\n');
}

// Stop a run: the recorded pid (provider, or deferred worker) and the worker's provider child.
// Providers are spawned detached, so each is its own process group.
// A pid from a sidecar may have been reused by an unrelated process: where /proc is available, only
// processes whose command line names this prompt file are signalled.
function ours(pid, prompt) {
  let cmd;
  try {
    cmd = fs.readFileSync(`/proc/${pid}/cmdline`, 'utf8');
  } catch {
    // No /proc (macOS, BSD): ask ps. If that fails too the pid is trusted, as before.
    const r = cp.spawnSync('ps', ['-o', 'command=', '-p', String(pid)], { encoding: 'utf8' });
    if (r.status !== 0 || !r.stdout) return true;
    cmd = r.stdout;
  }
  return cmd.includes(path.basename(prompt));
}

async function killRun(prompt, pid) {
  const pids = [pid, Number(readText(prompt + '.child').trim())].filter((n) => Number.isInteger(n) && n > 1 && ours(n, prompt));
  const signal = (sig) => { for (const n of pids) { try { process.kill(-n, sig); } catch { try { process.kill(n, sig); } catch { /* gone */ } } } };
  signal('SIGTERM');
  for (let i = 0; i < 12 && pids.some(alive); i++) await new Promise((r) => setTimeout(r, 250));
  if (pids.some(alive)) { signal('SIGKILL'); await new Promise((r) => setTimeout(r, 250)); }
}

// Fresh usage for learning the cost of the run; never fails the relay.
async function usageNow(ctx) {
  try { return await engine.gather(ctx, engine.loadState(ctx), { bypassCache: true }); } catch { return null; }
}

// A finished run without a report is recorded and, at most once per prompt, re-run on another lane:
// a free run on the normal lanes, an opencode or claude run on the other subscription when its
// outcome is listed in lanes.escalate_on. Returns null (nothing to do), {recorded} (recorded, no
// escalation) or {pid} (a new run to wait for).
async function maybeEscalate(prompt, cwd, ctx, forceFailure) {
  const from = readText(prompt + '.provider').trim();
  if (!['free', 'opencode', 'claude'].includes(from)) return null;
  const base = readText(prompt + '.jsonl').split('\n').filter(Boolean);
  if (extractReport(base).report && !forceFailure) return null;
  const cfg = ctx.cfg;
  if (fs.existsSync(prompt + '.escalated')) return null;
  if (from === 'free' ? !cfg.free_lane.escalate_on_failure : !(cfg.lanes.escalate_on || []).length) return null;
  const agent = readText(prompt + '.agent').trim();
  const model = readText(prompt + '.model').trim();
  let rec;
  try {
    rec = engine.recordRunDetailed(ctx, {
      provider: from, model, agent: agent || 'unknown', logFile: prompt + '.jsonl', errFile: prompt + '.err', extraFailure: true,
      usage: from === 'free' ? null : await usageNow(ctx),
    });
  } catch { return null; }
  const keep = { recorded: rec.summary };
  if (from !== 'free' && !cfg.lanes.escalate_on.includes(rec.outcome)) return keep;
  const opts = { excludeFree: true, excludeProvider: from === 'free' ? undefined : from };
  const map = (d) => (d.verdict === 'wait' || d.verdict === 'paygo' ? d.verdict : d.verdict === 'claude' ? 'claude' : 'opencode');
  // Look first without claiming anything: a pinned agent, or nothing else available, means no escalation.
  if (from !== 'free') {
    let peek;
    try { peek = map(await engine.pick(ctx, agent, { ...opts, dryRun: true })); } catch { return keep; }
    if (peek === 'wait' || peek === from) return keep;
  }
  const d = await safePick(ctx, agent, opts);
  const verdict = map(d);
  if (from !== 'free' && (verdict === 'wait' || verdict === from)) return keep;
  if (verdict !== 'wait' && !onPath(binFor(providerOf(verdict)))) return keep;
  fs.writeFileSync(prompt + '.escalated', `${from} ${from === 'free' ? model : rec.key} ${rec.outcome} -> ${verdict}\n`);
  for (const ext of ['jsonl', 'err']) {
    try { fs.renameSync(`${prompt}.${ext}`, `${prompt}.${from}.${ext}`); } catch { /* best effort */ }
  }
  process.stderr.write(`relay: ${from} run ${from === 'free' ? model : rec.key} ended with ${rec.outcome}; escalating to ${verdict}\n`);
  if (verdict === 'wait') return { pid: spawnDeferred(agent, cwd, prompt).pid };
  const child = launch({ verdict, model: d.model }, { agent, cwd, prompt, cfg });
  child.unref();
  fs.rmSync(prompt + '.child', { force: true });
  fs.writeFileSync(prompt + '.pid', child.pid + '\n');
  return { pid: child.pid };
}

async function wait(prompt) {
  if (!prompt) { console.log(USAGE); return 2; }
  let pid = Number(readText(prompt + '.pid').trim());
  if (!pid) { console.log(`relay-failure: no pid file for ${prompt}`); return 2; }
  const secs = Number(process.env.BALANCER_RELAY_WAIT_SECONDS || 570);
  const deadline = Date.now() + secs * 1000;
  const cwd = process.cwd();
  const ctx = engine.makeCtx();
  const maxMs = ctx.cfg.relay.max_run_minutes * 60000;
  // The outcome of a run is recorded exactly once; later wait calls replay the stored line.
  let recorded = readText(prompt + '.recorded').trim() || null;
  for (;;) {
    while (alive(pid) && Date.now() < deadline) {
      // The clock starts when the provider is launched, so time spent deferred does not count.
      const launched = Number(readText(prompt + '.launched').trim());
      if (maxMs > 0 && launched && Date.now() - launched > maxMs) {
        await killRun(prompt, pid);
        fs.writeFileSync(prompt + '.timeout', `${ctx.cfg.relay.max_run_minutes}\n`);
        break;
      }
      await new Promise((r) => setTimeout(r, 250));
    }
    if (alive(pid)) { console.log('RUNNING'); return 0; }
    if (recorded) break;
    const next = await maybeEscalate(prompt, cwd, ctx, fs.existsSync(prompt + '.timeout'));
    if (!next) break;
    if (next.recorded) recorded = next.recorded;
    if (!next.pid) break;
    pid = next.pid;
    fs.rmSync(prompt + '.timeout', { force: true });
  }

  console.log('DONE');
  let provider = readText(prompt + '.provider', 'opencode').trim();
  if (!['claude', 'free', 'paygo'].includes(provider)) provider = 'opencode';
  const model = provider === 'free' ? readText(prompt + '.model').trim() : undefined;
  const agent = readText(prompt + '.agent').trim();
  const base = readText(prompt + '.base').trim();
  const timedOut = readText(prompt + '.timeout').trim();
  const { report, errors, commands } = extractReport(readText(prompt + '.jsonl').split('\n').filter(Boolean));
  if (timedOut) console.log(`relay-failure: timeout after ${timedOut} min (run killed; relay.max_run_minutes)`);
  if (report) {
    console.log('----- FINAL REPORT -----');
    console.log(report);
  } else {
    console.log('relay-failure: no-report');
    console.log('----- LAST TOOL COMMANDS (salvage) -----');
    for (const c of commands.slice(-6)) console.log('  ' + c);
    if (!commands.length) console.log('  (none recorded)');
  }
  if (errors.length) {
    console.log(`----- ${provider.toUpperCase()} ERRORS -----`);
    console.log(errors.join('\n'));
  }
  if (report && !/(\bpass(ed|es|ing)?\b|\bok\b|\bGATE|\bcanar)/i.test(report)) {
    console.log('relay-warning: report contains no verification output; verify the gates yourself before accepting');
  }
  const err = readText(prompt + '.err');
  if (err.trim()) {
    console.log('----- STDERR (last 40 lines) -----');
    console.log(err.replace(/\n+$/, '').split('\n').slice(-40).join('\n'));
  }
  console.log('----- ORCHESTRATOR CHECK (repo state, measured by the relay) -----');
  console.log(repoDelta(base, cwd));
  try {
    if (!recorded) {
      if (provider === 'claude') engine.harvestClaudeUsage(ctx, prompt + '.jsonl');
      recorded = engine.recordRun(ctx, {
        provider, model, agent: agent || 'unknown', logFile: prompt + '.jsonl', errFile: prompt + '.err',
        extraFailure: !report || !!timedOut, usage: provider === 'opencode' || provider === 'claude' ? await usageNow(ctx) : null,
      });
    }
    console.log(recorded);
    fs.writeFileSync(prompt + '.recorded', recorded + '\n');
  } catch { /* reactive bookkeeping never fails the relay */ }
  const esc = /^(\S+) (\S+) (\S+) -> (\S+)$/.exec(readText(prompt + '.escalated').trim());
  if (esc) console.log(`relay: escalated from ${esc[1]} (${esc[2]}: ${esc[3]}) to ${esc[4]}`);
  console.log(`relay: ${provider} (log: ${prompt}.jsonl)`);
  return 0;
}

// The orchestrator's judgement of a finished run. It only feeds the decision log.
function verdict(prompt, v) {
  if (!prompt || !['accept', 'reject'].includes(v)) { console.log(USAGE); return 2; }
  const provider = readText(prompt + '.provider').trim();
  if (!provider || provider === 'deferred') { console.log(`relay-failure: no finished run for ${prompt}`); return 2; }
  engine.recordVerdict(engine.makeCtx(), { provider, agent: readText(prompt + '.agent').trim(), model: readText(prompt + '.model').trim(), verdict: v });
  console.log(`relay: recorded ${v} for ${provider}`);
  return 0;
}

// Stop a running or deferred run. Nothing is counted against the provider or the model.
async function cancel(prompt) {
  if (!prompt) { console.log(USAGE); return 2; }
  const pid = Number(readText(prompt + '.pid').trim());
  if (!pid) { console.log(`relay-failure: no pid file for ${prompt}`); return 2; }
  if (!alive(pid)) { console.log(`relay: not running (pid ${pid})`); return 0; }
  await killRun(prompt, pid);
  const provider = readText(prompt + '.provider').trim();
  try {
    if (provider !== 'deferred') {
      engine.releaseRun(engine.makeCtx(), { provider, agent: readText(prompt + '.agent').trim(), model: readText(prompt + '.model').trim() });
    }
  } catch { /* best effort */ }
  fs.writeFileSync(prompt + '.recorded', 'balancer: cancelled (not recorded)\n');
  console.log(`cancelled pid ${pid}${alive(pid) ? ' (still alive)' : ''}`);
  return 0;
}

async function main(argv) {
  const [cmd, a, b] = argv;
  if (cmd === 'start') return start(a, b);
  if (cmd === 'wait') return wait(a);
  if (cmd === 'cancel') return cancel(a);
  if (cmd === 'verdict') return verdict(a, b);
  if (cmd === '_deferred') return deferred(a, b);
  console.log(USAGE);
  return 2;
}

main(process.argv.slice(2)).then((c) => process.exit(c), (e) => {
  console.log('relay-failure: ' + String(e && e.message).slice(0, 200));
  process.exit(1);
});
